#: classes/admin/mrkv-uamp-admin.php:65
#: classes/admin/mrkv-uamp-admin.php:308
msgid "Settings"
msgstr "Налаштування"

#: classes/admin/mrkv-uamp-admin.php:97
msgid "Copied"
msgstr "Скопійовано"

#: classes/admin/mrkv-uamp-admin.php:98
msgid "Searching…"
msgstr "Пошук…"

#: classes/admin/mrkv-uamp-admin.php:99
msgid "Nothing found. You can also type a Rozetka category ID."
msgstr "Нічого не знайдено. Можна також ввести ID категорії Rozetka."

#: classes/admin/mrkv-uamp-admin.php:100
msgid "Type a category name or ID"
msgstr "Введіть назву або ID категорії"

#. translators: %s: Rozetka category ID typed in the picker
#: classes/admin/mrkv-uamp-admin.php:102
#, php-format
msgid "Use Rozetka ID %s"
msgstr "Використати ID Rozetka %s"

#: classes/admin/mrkv-uamp-admin.php:103
msgid "Changing the folder or file name changes the feed URL. Update it in the marketplace cabinet afterwards. Continue?"
msgstr "Зміна папки або назви файлу змінює адресу фіда. Після цього оновіть її в кабінеті маркетплейсу. Продовжити?"

#: classes/admin/mrkv-uamp-admin.php:115
msgid "Feeds"
msgstr "Фіди"

#: classes/admin/mrkv-uamp-admin.php:174
msgid "Settings saved. They apply from the next feed build."
msgstr "Налаштування збережено. Вони діють з наступного оновлення фіда."

#: classes/admin/mrkv-uamp-admin.php:175
msgid "Feed created. Fill in the settings below, then build the feed."
msgstr "Фід створено. Заповніть налаштування нижче, потім сформуйте фід."

#: classes/admin/mrkv-uamp-admin.php:176
msgid "The build has started in the background. You can leave this page."
msgstr "Формування запущено у фоні. Можна закрити цю сторінку."

#: classes/admin/mrkv-uamp-admin.php:177
msgid "The feed is being written right now. Try again in a minute."
msgstr "Фід саме зараз записується. Спробуйте за хвилину."

#: classes/admin/mrkv-uamp-admin.php:178
msgid "Feed paused: it is no longer updated, the last file stays available."
msgstr "Фід призупинено: він більше не оновлюється, останній файл лишається доступним."

#: classes/admin/mrkv-uamp-admin.php:179
msgid "Feed resumed."
msgstr "Фід відновлено."

#: classes/admin/mrkv-uamp-admin.php:180
msgid "Feed deleted."
msgstr "Фід видалено."

#. translators: %s: log source name
#: classes/admin/mrkv-uamp-admin.php:181
#, php-format
msgid "Something went wrong. See WooCommerce → Status → Logs (%s)."
msgstr "Щось пішло не так. Дивіться WooCommerce → Статус → Журнали (%s)."

#. translators: %s: log source name
#: classes/admin/mrkv-uamp-admin.php:182
msgid "Rozetka category directory updated."
msgstr "Довідник категорій Rozetka оновлено."

#: classes/admin/mrkv-uamp-admin.php:183
msgid "The Rozetka category directory is being updated right now. Reload the page in a minute."
msgstr "Довідник категорій Rozetka саме оновлюється. Перезавантажте сторінку за хвилину."

#: classes/admin/mrkv-uamp-admin.php:184
msgid "The Rozetka category directory could not be updated. The reason is shown below."
msgstr "Не вдалося оновити довідник категорій Rozetka. Причина — нижче."

#. translators: %s: list of marketplaces
#: classes/admin/mrkv-uamp-admin.php:205
#, php-format
msgid "UA Marketplaces 2.0: your feeds (%s) were moved to the new settings. Feed URLs did not change, so nothing needs updating in the marketplace cabinets. The feeds are being rebuilt in the background."
msgstr "UA Marketplaces 2.0: ваші фіди (%s) перенесено в нові налаштування. Адреси фідів не змінилися, тож у кабінетах маркетплейсів нічого міняти не треба. Фіди перебудовуються у фоні."

#: classes/admin/mrkv-uamp-admin.php:208
msgid "Open the feeds"
msgstr "Відкрити фіди"

#: classes/admin/mrkv-uamp-admin.php:222
msgid "Each feed is an XML file the marketplace downloads on its own schedule. Copy its URL into the marketplace cabinet once; it never changes."
msgstr "Кожен фід — це XML-файл, який маркетплейс завантажує за власним розкладом. Скопіюйте його адресу в кабінет маркетплейсу один раз — вона не змінюється."

#: classes/admin/mrkv-uamp-admin.php:229
#: classes/admin/mrkv-uamp-admin.php:255
msgid "Marketplace"
msgstr "Маркетплейс"

#: classes/admin/mrkv-uamp-admin.php:230
#: classes/admin/mrkv-uamp-admin.php:458
#: classes/admin/mrkv-uamp-admin.php:461
msgid "Feed URL"
msgstr "Адреса фіда"

#: classes/admin/mrkv-uamp-admin.php:231
msgid "Status"
msgstr "Стан"

#: classes/admin/mrkv-uamp-admin.php:232
msgid "Build"
msgstr "Формування"

#: classes/admin/mrkv-uamp-admin.php:244
msgid "No feeds yet. Add one for each marketplace you sell on."
msgstr "Фідів ще немає. Додайте по одному для кожного маркетплейсу, де продаєте."

#: classes/admin/mrkv-uamp-admin.php:250
msgid "Add a feed"
msgstr "Додати фід"

#: classes/admin/mrkv-uamp-admin.php:261
msgid "Add feed"
msgstr "Додати фід"

#: classes/admin/mrkv-uamp-admin.php:276
msgid "Server cron"
msgstr "Серверний крон"

#: classes/admin/mrkv-uamp-admin.php:278
msgid "WP-Cron is disabled on this site (DISABLE_WP_CRON). Feeds are updated only if a server cron calls wp-cron.php."
msgstr "На цьому сайті WP-Cron вимкнено (DISABLE_WP_CRON). Фіди оновлюються, лише якщо серверний крон викликає wp-cron.php."

#: classes/admin/mrkv-uamp-admin.php:280
msgid "Feeds are built by WP-Cron, which runs only when someone opens the site. On a site with few visitors, add this line to the server cron (in the hosting panel or crontab) so feeds are updated on time:"
msgstr "Фіди формує WP-Cron, а він запускається, лише коли хтось відкриває сайт. Якщо відвідувачів мало, додайте цей рядок у серверний крон (у панелі хостингу або crontab), щоб фіди оновлювались вчасно:"

#: classes/admin/mrkv-uamp-admin.php:282
msgid "Server cron command"
msgstr "Команда для серверного крону"

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-admin.php:283
#: classes/admin/mrkv-uamp-admin.php:316
#: classes/admin/mrkv-uamp-admin.php:462
msgid "Copy"
msgstr "Копіювати"

#: classes/admin/mrkv-uamp-admin.php:285
msgid "Every 5 minutes. If your hosting panel asks only for a URL, use the address in quotes."
msgstr "Кожні 5 хвилин. Якщо панель хостингу просить лише URL, візьміть адресу в лапках."

#: classes/admin/mrkv-uamp-admin.php:303
msgid "Paused"
msgstr "Призупинено"

#: classes/admin/mrkv-uamp-admin.php:305
msgid "Active"
msgstr "Активний"

#: classes/admin/mrkv-uamp-admin.php:309
msgid "Resume"
msgstr "Відновити"

#: classes/admin/mrkv-uamp-admin.php:309
msgid "Pause"
msgstr "Призупинити"

#: classes/admin/mrkv-uamp-admin.php:310
msgid "Delete"
msgstr "Видалити"

