msgstr "Кожні 4 години"

#: classes/admin/mrkv-uamp-admin.php:373
msgid "Twice a day"
msgstr "Двічі на день"

#: classes/admin/mrkv-uamp-admin.php:374
msgid "Once a day"
msgstr "Раз на день"

