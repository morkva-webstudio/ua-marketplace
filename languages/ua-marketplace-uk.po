msgstr "Щогодини"

#: classes/admin/mrkv-uamp-admin.php:413
msgid "Every 4 hours"
msgstr "Кожні 4 години"

#: classes/admin/mrkv-uamp-admin.php:414
msgid "Twice a day"
msgstr "Двічі на день"

#: classes/admin/mrkv-uamp-admin.php:415
msgid "Once a day"
msgstr "Раз на день"

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-admin.php:445
#, php-format
msgid "Save %s settings"
msgstr "Зберегти налаштування %s"

#: classes/admin/mrkv-uamp-admin.php:455
msgid "Feed file and updates"
msgstr "Файл фіда й оновлення"

#: classes/admin/mrkv-uamp-admin.php:467
msgid "Folder and file name"
msgstr "Папка й назва файлу"

#: classes/admin/mrkv-uamp-admin.php:470
msgid "Folder"
msgstr "Папка"

#: classes/admin/mrkv-uamp-admin.php:477
msgid "Update"
msgstr "Оновлення"

#: classes/admin/mrkv-uamp-admin.php:485
msgid "The free version rebuilds every feed once a day. Rozetka downloads price lists every hour."
msgstr "Безкоштовна версія оновлює кожен фід раз на день. Rozetka завантажує прайс-листи щогодини."

#: classes/admin/mrkv-uamp-admin.php:490
msgid "Products per query"
msgstr "Товарів за запит"

#: classes/admin/mrkv-uamp-admin.php:493
msgid "The feed is built in short background steps of about 20 seconds, so the server time limit never matters. Lower this only if builds stop with memory errors."
msgstr "Фід формується у фоні короткими кроками приблизно по 20 секунд, тож обмеження часу на сервері не заважає. Зменшуйте значення, лише якщо формування зупиняється через нестачу пам'яті."

#: classes/admin/mrkv-uamp-admin.php:504
msgid "You are not allowed to manage marketplace feeds."
msgstr "У вас немає прав керувати фідами маркетплейсів."

#: classes/admin/mrkv-uamp-admin.php:515
msgid "This action needs a form submission."
msgstr "Ця дія виконується лише через форму."

#: classes/admin/mrkv-uamp-mapping-ui.php:21
msgid "Category mapping"
msgstr "Зіставлення категорій"

#: classes/admin/mrkv-uamp-mapping-ui.php:23
msgid "Pick the Rozetka category for each of your categories. Only products from mapped categories and their subcategories go into the feed."
msgstr "Оберіть категорію Rozetka для кожної вашої категорії. У фід потрапляють лише товари із зіставлених категорій та їхніх підкатегорій."

#. translators: 1: mapped categories, 2: all categories
#: classes/admin/mrkv-uamp-mapping-ui.php:30
#, php-format
msgid "%1$d of %2$d categories mapped"
msgstr "Зіставлено %1$d з %2$d категорій"

#: classes/admin/mrkv-uamp-mapping-ui.php:40
msgid "Your shop has no product categories yet."
msgstr "У магазині ще немає категорій товарів."

#: classes/admin/mrkv-uamp-mapping-ui.php:48
msgid "Your category"
msgstr "Ваша категорія"

#: classes/admin/mrkv-uamp-mapping-ui.php:49
msgid "Rozetka category"
msgstr "Категорія Rozetka"

#: classes/admin/mrkv-uamp-mapping-ui.php:68
msgid "— Not exported —"
msgstr "— Не вивантажується —"

#. translators: 1: number of Rozetka categories, 2: date
#: classes/admin/mrkv-uamp-mapping-ui.php:88
#, php-format
msgid "Rozetka directory: %1$d category, updated %2$s"
msgid_plural "Rozetka directory: %1$d categories, updated %2$s"
msgstr[0] "Довідник Rozetka: %1$d категорія, оновлено %2$s"
msgstr[1] "Довідник Rozetka: %1$d категорії, оновлено %2$s"
msgstr[2] "Довідник Rozetka: %1$d категорій, оновлено %2$s"

#: classes/admin/mrkv-uamp-mapping-ui.php:93
msgid "The Rozetka category directory is loading in the background. Until then, type a Rozetka category ID in the picker."
msgstr "Довідник категорій Rozetka завантажується у фоні. Поки що введіть ID категорії Rozetka вручну."

#: classes/admin/mrkv-uamp-mapping-ui.php:95
msgid "Refresh"
msgstr "Оновити"

#. translators: %s: reason
#: classes/admin/mrkv-uamp-mapping-ui.php:99
#, php-format
msgid "Could not update the Rozetka category directory: %s. Type a Rozetka category ID in the picker meanwhile."
msgstr "Не вдалося оновити довідник категорій Rozetka: %s. Поки що введіть ID категорії Rozetka вручну."

#: classes/admin/mrkv-uamp-product-fields.php:53
msgid "Choose an image"
msgstr "Оберіть зображення"

#: classes/admin/mrkv-uamp-product-fields.php:54
msgid "Use this image"
msgstr "Використати це зображення"

#: classes/admin/mrkv-uamp-product-fields.php:79
msgid "Leave out of the feed"
msgstr "Не додавати у фід"

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-product-fields.php:81
#, php-format
msgid "Do not send this product to %s."
msgstr "Не передавати цей товар у %s."

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-product-fields.php:87
#, php-format
msgid "Name on %s"
msgstr "Назва на %s"

#: classes/admin/mrkv-uamp-product-fields.php:90
msgid "Replaces the product name in the feed. Variations keep their attributes after it."
msgstr "Замінює назву товару у фіді. Варіації зберігають свої атрибути після неї."

#: classes/admin/mrkv-uamp-product-fields.php:95
msgid "Description on Rozetka"
msgstr "Опис на Rozetka"

#: classes/admin/mrkv-uamp-product-fields.php:107
msgid "Main image URL"
msgstr "Адреса головного зображення"

#: classes/admin/mrkv-uamp-product-fields.php:111
msgid "Replaces the main product image in the feed (HTTPS only)."
msgstr "Замінює головне зображення товару у фіді (лише HTTPS)."

#: classes/admin/mrkv-uamp-product-fields.php:134
msgid "Replaces the product description in the feed. Leave empty to use the product description."
msgstr "Замінює опис товару у фіді. Залиште порожнім, щоб використовувати опис товару."

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-product-fields.php:167
#, php-format
msgid "%s image URL"
msgstr "Адреса зображення для %s"

#: classes/admin/mrkv-uamp-product-fields.php:172
msgid "Replaces the main picture of this variation in the feed."
msgstr "Замінює головне фото цієї варіації у фіді."

#: classes/admin/mrkv-uamp-product-fields.php:196
msgid "Marketplace names"
msgstr "Назви на маркетплейсах"

#: classes/admin/mrkv-uamp-settings.php:25
msgid "Shop"
msgstr "Магазин"

#: classes/admin/mrkv-uamp-settings.php:30
msgid "Shop name"
msgstr "Назва магазину"

#: classes/admin/mrkv-uamp-settings.php:32
msgid "The <name> of the shop in the feed. Empty: the site title."
msgstr "<name> магазину у фіді. Порожньо — назва сайту."

#: classes/admin/mrkv-uamp-settings.php:37
msgid "Company"
msgstr "Компанія"

#: classes/admin/mrkv-uamp-settings.php:39
msgid "Legal name of the seller. Empty: the site tagline."
msgstr "Юридична назва продавця. Порожньо — опис сайту."

#: classes/admin/mrkv-uamp-settings.php:45
msgid "Brand"
msgstr "Бренд"

#: classes/admin/mrkv-uamp-settings.php:47
msgid "Rozetka requires a brand (<vendor>) for every product and groups variations only within one brand."
msgstr "Rozetka вимагає бренд (<vendor>) для кожного товару і групує варіації лише в межах одного бренду."

#: classes/admin/mrkv-uamp-settings.php:48
msgid "Prom imports a brand only if it exists in the Prom brand list."
msgstr "Prom імпортує бренд, лише якщо він є в довіднику брендів Prom."

#: classes/admin/mrkv-uamp-settings.php:53
msgid "One brand for all products"
msgstr "Один бренд для всіх товарів"

#: classes/admin/mrkv-uamp-settings.php:54
msgid "When set, every product gets this brand and the source below is ignored."
msgstr "Якщо заповнено, усі товари отримують цей бренд, а джерело нижче не враховується."

#: classes/admin/mrkv-uamp-settings.php:59
msgid "Brand source"
msgstr "Джерело бренду"

#: classes/admin/mrkv-uamp-settings.php:61
msgid "— Not set —"
msgstr "— Не задано —"

#: classes/admin/mrkv-uamp-settings.php:62
msgid "WooCommerce Brands"
msgstr "Бренди WooCommerce"

#: classes/admin/mrkv-uamp-settings.php:63
msgid "Perfect Brands for WooCommerce"
msgstr "Perfect Brands for WooCommerce"

#: classes/admin/mrkv-uamp-settings.php:64
msgid "Product attribute"
msgstr "Атрибут товару"

#: classes/admin/mrkv-uamp-settings.php:65
msgid "Custom field (post meta)"
msgstr "Довільне поле (post meta)"

#: classes/admin/mrkv-uamp-settings.php:72
msgid "Brand attribute"
msgstr "Атрибут бренду"

#: classes/admin/mrkv-uamp-settings.php:79
msgid "Custom field key"
msgstr "Ключ довільного поля"

#: classes/admin/mrkv-uamp-settings.php:81
msgid "The meta key that holds the brand name on the product."
msgstr "Ключ мета-поля, у якому записано бренд товару."

#: classes/admin/mrkv-uamp-settings.php:88
msgid "Products and prices"
msgstr "Товари й ціни"

#: classes/admin/mrkv-uamp-settings.php:112
msgid "Description template"
msgstr "Шаблон опису"

#. translators: %s: list of shortcodes
#: classes/admin/mrkv-uamp-settings.php:115
