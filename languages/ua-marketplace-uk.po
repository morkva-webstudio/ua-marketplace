#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-admin.php:330
#, php-format
msgid "Delete the %s feed?"
msgstr "Видалити фід %s?"

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-admin.php:331
msgid "The feed stops updating. If the marketplace still downloads this URL, keep the file so your products are not taken off the marketplace until you remove the price list there."
msgstr "Фід перестане оновлюватися. Якщо маркетплейс ще завантажує цю адресу, залиште файл, щоб товари не зникли з маркетплейсу, доки ви не видалите там прайс-лист."

#: classes/admin/mrkv-uamp-admin.php:333
msgid "Settings and category mapping are kept: adding the feed again restores them."
msgstr "Налаштування і зіставлення категорій зберігаються: якщо додати фід знову, вони повернуться."

#: classes/admin/mrkv-uamp-admin.php:339
msgid "Also delete the XML file"
msgstr "Також видалити XML-файл"

#: classes/admin/mrkv-uamp-admin.php:341
msgid "Delete feed"
msgstr "Видалити фід"

#: classes/admin/mrkv-uamp-admin.php:342
