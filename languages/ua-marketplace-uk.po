#. Plugin Name of the plugin
#: morkvawrs-plugin.php
msgid "UA Marketplaces – Rozetka & Prom.ua XML Feeds for WooCommerce"
msgstr "UA Marketplaces – XML-фіди Rozetka і Prom.ua для WooCommerce"

#. Plugin URI of the plugin
#: morkvawrs-plugin.php
msgid "https://morkva.co.ua/shop-2/woocommerce-rozetka-sync"
msgstr ""

#. Description of the plugin
#: morkvawrs-plugin.php
msgid "XML feeds for Rozetka and Prom.ua from your WooCommerce catalog, generated in the background in small batches."
msgstr "XML-фіди для Rozetka і Prom.ua з каталогу WooCommerce, що формуються у фоні невеликими частинами."

#. Author of the plugin
#: morkvawrs-plugin.php
msgid "morkva"
msgstr "morkva"

