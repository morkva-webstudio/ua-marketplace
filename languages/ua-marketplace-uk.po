#: classes/admin/mrkv-uamp-admin.php:315
#, php-format
msgid "%s feed URL"
msgstr "Адреса фіда %s"

#: classes/admin/mrkv-uamp-admin.php:319
msgid "Open"
msgstr "Відкрити"

#: classes/admin/mrkv-uamp-admin.php:321
msgid "The file appears after the first build."
msgstr "Файл з'явиться після першого формування."

#: classes/admin/mrkv-uamp-admin.php:329
msgid "Not updated while paused"
msgstr "Не оновлюється, поки призупинено"

#. translators: 1: next update time, 2: schedule such as "Once a day"
#: classes/admin/mrkv-uamp-admin.php:332
#, php-format
msgid "Next: %1$s (%2$s)"
msgstr "Наступне: %1$s (%2$s)"

#. translators: 1: next update time, 2: schedule such as "Once a day"
#: classes/admin/mrkv-uamp-admin.php:332
msgid "scheduling…"
msgstr "планується…"

#: classes/admin/mrkv-uamp-admin.php:345
msgid "Restart build"
msgstr "Почати формування заново"

#: classes/admin/mrkv-uamp-admin.php:345
msgid "Build now"
msgstr "Сформувати зараз"

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-admin.php:371
#, php-format
msgid "Delete the %s feed?"
msgstr "Видалити фід %s?"

#. translators: %s: marketplace
#: classes/admin/mrkv-uamp-admin.php:372
msgid "The feed stops updating. If the marketplace still downloads this URL, keep the file so your products are not taken off the marketplace until you remove the price list there."
msgstr "Фід перестане оновлюватися. Якщо маркетплейс ще завантажує цю адресу, залиште файл, щоб товари не зникли з маркетплейсу, доки ви не видалите там прайс-лист."

#: classes/admin/mrkv-uamp-admin.php:374
msgid "Settings and category mapping are kept: adding the feed again restores them."
msgstr "Налаштування і зіставлення категорій зберігаються: якщо додати фід знову, вони повернуться."

#: classes/admin/mrkv-uamp-admin.php:380
msgid "Also delete the XML file"
msgstr "Також видалити XML-файл"

#: classes/admin/mrkv-uamp-admin.php:382
msgid "Delete feed"
msgstr "Видалити фід"

#: classes/admin/mrkv-uamp-admin.php:383
msgid "Cancel"
msgstr "Скасувати"

